# Copiar a .env.local y completar. En desarrollo todo es opcional.

# Secreto para firmar la cookie de sesión (JWT HS256). OBLIGATORIO en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Fuente de datos: "mock" (datos hardcodeados, default) o "portal" (API del Portal de afiliaciones).
DATA_SOURCE=mock

# Solo con DATA_SOURCE=portal. Credencial server-to-server: nunca llega al navegador.
PORTAL_API_URL=https://masmutual.grupodelsud.com/api
PORTAL_API_TOKEN=

# Latencia simulada del mock en ms (para ver estados de carga). 0 para desactivar.
MOCK_LATENCY_MS=200
